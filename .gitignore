# ==========================================
# 1. 忽略无后缀的 Linux / Mac 可执行文件
# ==========================================
*
!*/

# 常见无后缀说明文件放行
!LICENSE
!Makefile

# ==========================================
# 2. XCPC 源码、文档与对拍测试点白名单
# ==========================================
# C/C++ 源码及头文件
!*.cpp
!*.cc
!*.c
!*.h
!*.hpp

# 竞赛脚本与对拍生成器（Python / Shell / Bat）
!*.py
!*.sh
!*.bat

# 题解笔记与输入输出测试样例
!*.md
!*.txt
!*.pdf
!*.in
!*.ans

# 代码模板/配置文件/IDE 工程
!.gitignore
!*.json
!*.yaml
!*.yml
!*.cbp
!*.layout

# 题解配图
!*.png
!*.jpg
!*.jpeg
!*.gif

# ==========================================
# 3. 显式黑名单（即便在上述白名单内也必须忽略）
# ==========================================
# 编译可执行文件与符号（Win/Mac/Linux）
*.exe
*.out
a.out
*.out.dSYM/
*.dSYM/
*.o
*.obj
*.bin

# 对拍/评测产生的临时对比文件
*.diff
*.tmp
*.temp

# 刷题插件缓存（CPH / Competitive Programming Helper）
.cph/
**/.cph/
.cph-ng/
**/.cph-ng/
*.prob

# 本地编辑器及双端操作系统垃圾
*.bak
.obsidian/
**/.obsidian/
.vscode/
**/.vscode/
.devcontainer/
**/.devcontainer/
Dockerfile
docker-compose*.yml
docker-compose*.yaml
.idea/
**/.idea/
.vs/
**/.vs/
.DS_Store
**/.DS_Store
._*
Thumbs.db
Desktop.ini

# 本地个人敏感文件
*.local
*.local.*
.env
.env.*
!.env.example

# 本地运行配置（FAST Olympic Coding 插件设置，不上传）
runSettings.json
**/runSettings.json
